# Copy this file to .env.local and fill in your Firebase project's web app
# config (Firebase console → Project settings → General → Your apps → SDK
# setup and configuration → Config). All public site content and the
# contact/booking forms fall back to placeholder seed data until these are
# set — see README.md "Firebase setup".

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Used for metadata/Open Graph URLs and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Image uploads (admin inline editor) go to Cloudinary's free tier, not
# Firebase Storage — Storage now requires the paid Blaze plan to even
# create a bucket. Create a free account at cloudinary.com, then an
# *unsigned* upload preset under Settings → Upload, and fill these in —
# see README.md "Image uploads".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
